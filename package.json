{
  "name": "cubauth",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && vitest run",
    "test:core": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none test/core.test.ts",
    "test:db": "npm run test:core",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "keys": "node scripts/generate-keys.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "hono": "^4.13.8",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260918.1": true
  }
}
